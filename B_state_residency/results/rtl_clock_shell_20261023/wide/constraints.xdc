# Research interface envelope, not a board/platform constraint file.
# The same BUFG output edge is the reference for upstream/downstream budgets.
create_clock -period 10.000 -name core_clk [get_ports clk]
set _xlnx_shared_i0 [get_ports -filter {DIRECTION == IN && NAME != clk}]
set_input_delay -clock core_clk -reference_pin [get_pins b_clock/O] -max 2.000 $_xlnx_shared_i0
set_input_delay -clock core_clk -reference_pin [get_pins b_clock/O] -min 0.500 $_xlnx_shared_i0
set _xlnx_shared_i1 [get_ports -filter {DIRECTION == OUT}]
set_output_delay -clock core_clk -reference_pin [get_pins b_clock/O] -max 2.000 $_xlnx_shared_i1
set_output_delay -clock core_clk -reference_pin [get_pins b_clock/O] -min -0.500 $_xlnx_shared_i1


