    set fndPath [find_routing_path -from [lindex [get_nodes -of \  
       [get_site_pins -of [get_nets wbOutputData_OBUF[14]]]] 0] -to \  
       [lindex [get_nodes -of  [get_site_pins -of \  
       [get_nets wbOutputData_OBUF[14]]]] 1]]  
